# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.pro text eol=lf
*.txt text eol=lf
*.svg text eol=lf

# Shell scripts must have LF
*.sh text eol=lf
gradlew text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.tflite binary
*.ogg binary
*.wav binary
*.mp3 binary
*.jar binary
*.aar binary
*.so binary
*.keystore binary
*.jks binary
